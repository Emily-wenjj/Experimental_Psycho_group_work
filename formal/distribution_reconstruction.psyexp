        <Param val="data_path = &quot;../pre/data/result.csv&quot;&amp;#10;if os.path.exists(data_path):&amp;#10;    df = pd.read_csv(data_path)&amp;#10;    valid_si = df[&quot;final_Si&quot;].dropna()&amp;#10;    if len(valid_si) &gt; 0:&amp;#10;        Si = valid_si.iloc[-1]&amp;#10;    else:&amp;#10;        Si = 6&amp;#10;else:&amp;#10;    Si = 6&amp;#10;thisExp.addData(&quot;Si&quot;,Si)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
